{
  "name": "dsh-main-agent",
  "version": "0.21.0",
  "description": "面向 DeepSeek Harness 的常驻监督者 Agent：main-agent preset 承载目标循环、worker 编队与跨模式监督层，可作为一个 dsh bundle 安装",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./spawn": "./lib/spawn.js",
    "./control": "./lib/control.js",
    "./list-agents": "./lib/list-agents.js",
    "./goal": "./lib/goal.js",
    "./checks": "./lib/checks-tool.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "presets",
    "agent-presets",
    "prompts",
    "agi-template",
    "scripts"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "sync-preset": "node scripts/sync-prompts.mjs && node scripts/sync-preset-patch.mjs && node scripts/sync-prompts.mjs --stamp",
    "sync-profile": "node scripts/sync-profile.mjs",
    "repair-profile": "node scripts/repair-profile.mjs",
    "accept": "node scripts/accept-worker.mjs",
    "install-spec": "node scripts/install-spec.mjs",
    "prepack": "npm run sync-preset"
  },
  "license": "MIT",
  "devDependencies": {
    "yaml": "^2.9.1"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "supervisor",
    "subagent",
    "agent"
  ],
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/main-agent.patch.yml"
      ]
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/dsh-goal": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/dsh-schedule": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/dsh-subagent": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/schemastery": "^3.18.0"
  }
}
